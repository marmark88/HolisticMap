# Copy to /etc/holisticmap.env on the VM (chmod 640, root:www-data).
# Supabase → Project Settings → Database → URI (use “direct”, add ?sslmode=require if missing).

SECRET_KEY=change-me-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your.domain.com,your-vm-external-ip
DJANGO_CSRF_TRUSTED_ORIGINS=https://your.domain.com
DATABASE_URL=postgresql://postgres.[ref]:YOUR_PASSWORD@db.[ref].supabase.co:5432/postgres?sslmode=require
DATABASE_SSL_REQUIRE=True

# When nginx terminates TLS and proxies to Gunicorn:
DJANGO_USE_X_FORWARDED_PROTO=1
DJANGO_SECURE_SSL_REDIRECT=True
